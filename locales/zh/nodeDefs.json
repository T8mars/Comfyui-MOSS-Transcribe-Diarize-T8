        "name": "Attention 后端",
        "tooltip": "Auto 按 FlashAttention-2、SDPA、eager 顺序显式尝试并记录结果；显式后端失败时不会静默回退。"
      },
      "custom_model_path": { "name": "自定义模型绝对路径" }
    },
    "outputs": { "0": { "name": "MOSS 模型" }, "1": { "name": "模型信息" } }
  },
  "T8_MOSS_PromptHotwords": {
    "display_name": "MOSS 提示词与热词 · T8star-Aix",
