      "reject_repetition": { "name": "拒绝重复循环" }, "reject_truncation": { "name": "拒绝疑似截断" },
      "fail_on_unusable": { "name": "不可用时终止工作流" }
    },
    "outputs": { "0": { "name": "已评估转写对象" }, "1": { "name": "结果可用" }, "2": { "name": "质量报告 JSON" } }
  },
