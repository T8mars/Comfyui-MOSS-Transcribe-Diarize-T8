{
  "1": {
    "class_type": "T8_MOSS_ModelLoader",
    "inputs": {
      "model_name": "MOSS-Transcribe-Diarize",
      "device": "auto",
      "precision": "auto",
      "release_after_run": false,
      "verify_hashes": false,
      "memory_policy": "release_under_pressure",
      "attention_implementation": "auto",
      "custom_model_path": ""
    }
  },
  "2": {"class_type": "LoadAudio", "inputs": {"audio": "long_meeting.wav"}},
  "3": {
    "class_type": "T8_MOSS_PromptHotwords",
    "inputs": {
      "base_prompt": "请将长音频转写为文本，每段包含起止时间戳与说话人编号。",
      "preset_id": "zh_meeting",
      "hotwords": "OpenMOSS, ComfyUI, T8star-Aix",
      "language_hint": "中文",
      "strict_format": true
    }
  },
  "4": {
    "class_type": "T8_MOSS_TranscribeDiarize",
    "inputs": {"model": ["1", 0], "audio": ["2", 0], "max_new_tokens": 0, "prompt": ["3", 0], "silence_policy": "warn"}
  },
  "5": {
    "class_type": "T8_MOSS_TranscriptValidate",
    "inputs": {
      "raw_text": "",
      "media_duration_seconds": 0,
      "generated_tokens": 0,
      "max_new_tokens": 0,
      "transcript": ["4", 5]
    }
  },
  "6": {
    "class_type": "T8_MOSS_SubtitleExport",
    "inputs": {
      "transcript": ["5", 0],
      "speaker_names_json": "{}",
      "show_speaker": true,
      "filename_prefix": "moss_long_audio_checked",
      "write_files": true,
      "chunk_id": "long-part1",
      "cross_chunk_speaker_map_json": "{}"
    }
  },
  "7": {
    "class_type": "T8_MOSS_EnvironmentRelease",
    "inputs": {"action": "report_only", "model": ["1", 0]}
  }
}
