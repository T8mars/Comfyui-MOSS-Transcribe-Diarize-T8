{
  "1": {
    "class_type": "T8_MOSS_ModelLoader",
    "inputs": {
      "model_name": "MOSS-Transcribe-Diarize",
      "device": "auto",
      "precision": "auto",
      "release_after_run": false,
      "verify_hashes": false,
      "memory_policy": "release_under_pressure",
      "attention_implementation": "auto",
      "custom_model_path": ""
    }
  },
  "2": {"class_type": "LoadAudio", "inputs": {"audio": "long_meeting.wav"}},
  "3": {
    "class_type": "T8_MOSS_PromptHotwords",
    "inputs": {
      "base_prompt": "请将长音频转写为文本，每段包含起止时间戳与说话人编号。",
      "preset_id": "zh_meeting",
      "hotwords": "OpenMOSS, ComfyUI, T8star-Aix",
      "language_hint": "中文",
      "strict_format": true,
      "custom_language_hint": ""
    }
  },
  "4": {
    "class_type": "T8_MOSS_SmartLongAudio",
    "inputs": {
      "model": ["1", 0], "audio": ["2", 0], "max_new_tokens_per_chunk": 0, "prompt": ["3", 0],
      "target_chunk_minutes": 8.0, "max_chunk_minutes": 10.0, "overlap_seconds": 1.0,
      "split_strategy": "vad", "silence_policy": "warn", "vad_aggressiveness": 2,
      "retry_policy": "quality_failure", "checkpoint_mode": "read_write", "checkpoint_id": "long-meeting",
      "speaker_link_mode": "overlap_only"
    }
  },
  "5": {
    "class_type": "T8_MOSS_QualityGate",
    "inputs": {
      "transcript": ["4", 5],
      "min_end_coverage": 0.75,
      "max_unknown_speaker_ratio": 0.5,
      "reject_repetition": true,
      "reject_truncation": true,
      "fail_on_unusable": true
    }
  },
  "6": {
    "class_type": "T8_MOSS_SubtitleExport",
    "inputs": {
      "transcript": ["8", 0],
      "speaker_names_json": "{}",
      "show_speaker": true,
      "filename_prefix": "moss_long_audio_checked",
      "write_files": true,
      "chunk_id": "long-part1",
      "cross_chunk_speaker_map_json": "{}"
    }
  },
  "7": {
    "class_type": "T8_MOSS_EnvironmentRelease",
    "inputs": {"action": "report_only", "model": ["1", 0]}
  },
  "8": {
    "class_type": "T8_MOSS_SubtitlePostprocess",
    "inputs": {
      "transcript": ["5", 0],
      "min_duration": 1.0,
      "max_duration": 6.0,
      "max_chars_per_line": 24,
      "max_lines": 2,
      "merge_gap": 0.3,
      "max_chars_per_second": 20.0
    }
  }
}
