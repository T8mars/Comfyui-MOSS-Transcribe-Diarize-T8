{
  "1": {
    "class_type": "T8_MOSS_ModelLoader",
    "inputs": {
      "model_name": "MOSS-Transcribe-Diarize",
      "device": "auto",
      "precision": "auto",
      "release_after_run": false,
      "verify_hashes": false,
      "memory_policy": "keep",
      "attention_implementation": "auto",
      "custom_model_path": ""
    }
  },
  "2": {"class_type": "LoadAudio", "inputs": {"audio": "meeting.wav"}},
  "3": {
    "class_type": "T8_MOSS_PromptHotwords",
    "inputs": {
      "base_prompt": "请将音频转写为文本，每段包含起止时间戳与说话人编号。",
      "preset_id": "zh_meeting",
      "hotwords": "OpenMOSS, ComfyUI, T8star-Aix",
      "language_hint": "中文",
      "strict_format": true,
      "custom_language_hint": ""
    }
  },
  "4": {
    "class_type": "T8_MOSS_TranscribeDiarize",
    "inputs": {
      "model": ["1", 0], "audio": ["2", 0], "max_new_tokens": 0, "prompt": ["3", 0],
      "silence_policy": "warn", "preflight_backend": "webrtc", "vad_aggressiveness": 2,
      "retry_policy": "invalid_format"
    }
  },
  "6": {
    "class_type": "T8_MOSS_SubtitleStyle",
    "inputs": {
      "font_name": "Noto Sans CJK SC", "font_size": 0, "alignment": 2, "margin_v": 56,
      "speaker_colors": true, "primary_color": "&H00FFFFFF", "outline_color": "&H00000000",
      "back_color": "&H64000000", "outline": 3, "shadow": 1, "video_width": 1920, "video_height": 1080
    }
  },
  "5": {
    "class_type": "T8_MOSS_SubtitleExport",
    "inputs": {
      "transcript": ["7", 0],
      "speaker_names_json": "{\"S01\": \"主持人\", \"S02\": \"嘉宾\"}",
      "show_speaker": true,
      "filename_prefix": "moss_meeting",
      "write_files": true,
      "chunk_id": "meeting-part1",
      "cross_chunk_speaker_map_json": "{}",
      "style": ["6", 0]
    }
  },
  "7": {
    "class_type": "T8_MOSS_SubtitlePostprocess",
    "inputs": {
      "transcript": ["4", 5],
      "min_duration": 1.0,
      "max_duration": 6.0,
      "max_chars_per_line": 24,
      "max_lines": 2,
      "merge_gap": 0.3,
      "max_chars_per_second": 20.0
    }
  }
}
