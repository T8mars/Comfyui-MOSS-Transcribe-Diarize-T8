{
  "1": {
    "class_type": "T8_MOSS_ModelLoader",
    "inputs": {
      "model_name": "MOSS-Transcribe-Diarize",
      "device": "auto",
      "precision": "auto",
      "release_after_run": false,
      "verify_hashes": false,
      "custom_model_path": ""
    }
  },
  "2": {"class_type": "LoadAudio", "inputs": {"audio": "meeting.wav"}},
  "3": {
    "class_type": "T8_MOSS_PromptHotwords",
    "inputs": {
      "base_prompt": "请将音频转写为文本，每段包含起止时间戳与说话人编号。",
      "hotwords": "OpenMOSS, ComfyUI, T8star-Aix",
      "language_hint": "中文",
      "strict_format": true
    }
  },
  "4": {
    "class_type": "T8_MOSS_TranscribeDiarize",
    "inputs": {"model": ["1", 0], "audio": ["2", 0], "max_new_tokens": 0, "prompt": ["3", 0]}
  },
  "5": {
    "class_type": "T8_MOSS_SubtitleExport",
    "inputs": {
      "transcript": ["4", 5],
      "speaker_names_json": "{\"S01\": \"主持人\", \"S02\": \"嘉宾\"}",
      "show_speaker": true,
      "filename_prefix": "moss_meeting",
      "write_files": true
    }
  }
}
